# BlueMed LLM Configuration
# Copy this file to .env and fill in your API keys

# ===================================
# Model Selection
# ===================================
# Default models for experts and judge
# Options: ollama models, "gemini-*", "gpt-*", "hf:model_id"
EXPERT_MODEL=llama3.1:8b
JUDGE_MODEL=llama3.1:8b

# ===================================
# Ollama Configuration (Local Models)
# ===================================
# URL for Ollama server (only needed if using remote server)
OLLAMA_URL=http://localhost:11434

# ===================================
# Google Gemini API
# ===================================
# Get API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Gemini Embedding API (for RAG)
GOOGLE_API_KEY_EMBED=
EMBEDDING_MODEL=gemini-embedding-001

# ===================================
# OpenAI GPT API
# ===================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini

# ===================================
# HuggingFace API
# ===================================
# Get token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ===================================
# RAG (Retrieval Augmented Generation)
# ===================================
# Enable/disable RAG retrieval
USE_RETRIEVER=false

# Force rebuild vector databases
FORCE_REBUILD=false

# Vector database location
PERSIST_DIR=./chroma_db

# ===================================
# Judge Retrieval (judge2.0 feature)
# ===================================
# Give the judge access to WebMD and Mayo Clinic knowledge bases
# This allows the judge to verify expert claims with source knowledge
USE_JUDGE_RETRIEVER=false

# ===================================
# Weighted Voting System (judge2.0 feature)
# ===================================
# Enable weighted decision making between judge and experts
USE_WEIGHTED_VOTING=false
WEIGHT_JUDGE=0.4           # Judge weight (40%)
WEIGHT_EXPERT_A=0.3        # Mayo Clinic expert weight (30%)
WEIGHT_EXPERT_B=0.3        # WebMD expert weight (30%)

# ===================================
# Embedding Performance Settings
# ===================================
# Optimized for paid tier - adjust for free tier if needed
EMBED_BATCH_SIZE=500          # 500 for paid tier, 100 for free
EMBED_BATCH_DELAY=1.0         # 1.0 for paid tier, 5.0 for free
EMBED_RPM=3000                # 3000 for paid tier, 15 for free
EMBED_TPM=1000000             # 1M for paid tier, 1500 for free

# ===================================
# Quick Setup Examples
# ===================================
# Example 1: Use Ollama only (no API keys needed)
#   EXPERT_MODEL=llama3.1:8b
#   JUDGE_MODEL=llama3.1:8b

# Example 2: Use Gemini (free tier available)
#   GOOGLE_API_KEY=your_key_here
#   EXPERT_MODEL=gemini-2.0-flash
#   JUDGE_MODEL=gemini-2.0-flash

# Example 3: Use GPT-4o-mini
#   OPENAI_API_KEY=your_key_here
#   EXPERT_MODEL=gpt-4o-mini
#   JUDGE_MODEL=gpt-4o-mini

# Example 4: Mix providers
#   OPENAI_API_KEY=your_key_here
#   GOOGLE_API_KEY=your_key_here
#   EXPERT_MODEL=gpt-4o-mini
#   JUDGE_MODEL=gemini-1.5-pro

# Example 5: Use HuggingFace
#   HUGGINGFACE_API_KEY=your_token_here
#   EXPERT_MODEL=hf:meta-llama/Meta-Llama-3-8B-Instruct
#   JUDGE_MODEL=hf:mistralai/Mistral-7B-Instruct-v0.2
